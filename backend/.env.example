# Upstage API 키 (필수)
UPSTAGE_API_KEY=your_upstage_api_key_here

# 파일 업로드 저장 경로
# 로컬: uploads
# Vercel: /tmp/uploads  (서버리스 환경 — 재시작 시 초기화됨)
UPLOAD_DIR=uploads

# SQLite DB 경로
# 로컬: sqlite:///./receipt.db
# Vercel: sqlite:////tmp/receipt.db  (서버리스 환경 — 재시작 시 초기화됨)
DATABASE_URL=sqlite:///./receipt.db

# 허용 CORS 오리진 (쉼표 구분)
# 로컬: http://localhost:5173,http://localhost:3000
# 배포 후: https://your-app.vercel.app,https://your-app-git-main-yourteam.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
